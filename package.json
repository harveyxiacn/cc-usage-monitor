{
  "name": "cc-usage-monitor",
  "version": "0.6.0",
  "description": "Claude Code plugin: shows 5-hour and 7-day usage limits in the statusline and after every task",
  "main": "bin/statusline.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/format.test.js test/transcript.test.js test/statusline.test.js test/on-stop.test.js",
    "smoke:statusline": "node bin/statusline.js < test/fixtures/full.json",
    "smoke:stop": "node bin/on-stop.js < test/fixtures/full.json"
  },
  "keywords": [
    "claude-code",
    "claude",
    "plugin",
    "statusline",
    "usage",
    "rate-limits",
    "monitoring"
  ],
  "author": "harveyxiacn (https://github.com/harveyxiacn)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harveyxiacn/cc-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/harveyxiacn/cc-usage-monitor/issues"
  },
  "homepage": "https://github.com/harveyxiacn/cc-usage-monitor#readme",
  "files": [
    ".claude-plugin/",
    "bin/",
    "hooks/",
    "commands/",
    "lib/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
